# StackChan private-server — environment variables
#
# Every value below is OPTIONAL: the server falls back to the localhost defaults
# shown here (see src/xiaozhi/config.ts and src/main.ts). Copy to `.env` and edit
# as needed. main.ts auto-loads this file via dotenv, so `npm run start:prod`
# (and `npm run start`) picks it up automatically — no need to source/export.

# ----------------------------------------------------------------------------
# Server bind (main.ts)
# ----------------------------------------------------------------------------
# TCP port. Matches the production StackChan server; the firmware expects 12800.
PORT=12800
# Bind address. 0.0.0.0 lets the device reach it over the LAN.
HOST=0.0.0.0

# ----------------------------------------------------------------------------
# LLM — OpenAI-compatible /v1/chat/completions server (e.g. llama.cpp)
# ----------------------------------------------------------------------------
# Base URL INCLUDING the /v1 suffix (passed as-is to the OpenAI SDK / ChatOpenAI).
LLM_BASE_URL=http://127.0.0.1:10000/v1
# Dummy key — local servers don't check auth. Set a real key only for cloud.
LLM_API_KEY=sk-local-dummy
# Model name the server expects (llama.cpp usually ignores it).
LLM_MODEL=default
# System prompt that sets StackChan's persona.
LLM_SYSTEM_PROMPT=You are StackChan, a friendly desktop robot companion. Keep replies short, warm, and conversational. Your replies are read aloud by text-to-speech: never use emojis, emoticons, or other symbols that do not read well aloud.

# ----------------------------------------------------------------------------
# STT — OpenAI-compatible /v1/audio/transcriptions server (whisper)
# ----------------------------------------------------------------------------
# Backend: "whispercpp" for a native whisper.cpp whisper-server (Apple Silicon
# Metal — uses STT_WHISPERCPP_URL, not STT_BASE_URL), or "openai" for any
# OpenAI-compatible /v1/audio/transcriptions server (e.g. the Dockerized
# faster-whisper fallback, which listens on STT_BASE_URL below).
STT_BACKEND=whispercpp
# whisper.cpp /inference endpoint — only used when STT_BACKEND=whispercpp.
STT_WHISPERCPP_URL=http://127.0.0.1:10010/inference
STT_BASE_URL=http://127.0.0.1:8000/v1
STT_API_KEY=sk-local-dummy
# A model id your whisper server recognizes (NOT the OpenAI alias "whisper-1").
# Must match WHISPER__MODEL in docker-compose.yml. Ignored when
# STT_BACKEND=whispercpp (whisper.cpp picks the model at server start).
STT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# Spoken language hint. Leave EMPTY to let the server auto-detect.
STT_LANGUAGE=en

# ----------------------------------------------------------------------------
# TTS — OpenAI-compatible /v1/audio/speech server (Kokoro-FastAPI / openedai / Piper)
# Must be able to return response_format "pcm" (s16le mono 24 kHz).
# ----------------------------------------------------------------------------
TTS_BASE_URL=http://127.0.0.1:50060/v1
TTS_API_KEY=sk-local-dummy
# Kokoro-FastAPI expects "kokoro" (not the OpenAI alias "tts-1").
TTS_MODEL=kokoro
# Voice id understood by your TTS server (e.g. Kokoro "af_sky").
TTS_VOICE=af_sky

# ----------------------------------------------------------------------------
# Vision — OpenAI-compatible /v1/chat/completions server that accepts
# image_url content parts (vision.controller.ts / ai/vision.openai.ts).
# Answers the camera-photo questions behind the device's take_photo tool.
# URL / key / model default to the LLM_* settings above, so if your llama.cpp
# model is multimodal (has an --mmproj projector) you configure nothing here;
# set these only to route photos to a different server/model.
# ----------------------------------------------------------------------------
# VISION_BASE_URL=http://127.0.0.1:10000/v1
# VISION_API_KEY=sk-local-dummy
# VISION_MODEL=default
# Persona for photo descriptions (has its own default; the answer is spoken by
# the robot).
# VISION_SYSTEM_PROMPT=
# Hard cap (ms) on one photo inference. Must stay under 30000: the camera
# abandons the upload if response headers take longer than 30s.
# VISION_TIMEOUT_MS=25000

# ----------------------------------------------------------------------------
# Weather — get_weather server tool (tools/server-tools.ts)
# Answers "will it rain tomorrow?" / "what's the weather on Friday?" from JMA
# data via Open-Meteo's keyless /v1/jma endpoint (city names are geocoded).
# ----------------------------------------------------------------------------
# Location used when the user doesn't name a city. Any city name works.
# WEATHER_DEFAULT_LOCATION=Tokyo
# IANA timezone the forecast days align to (so "tomorrow" is the local day).
# WEATHER_TIMEZONE=Asia/Tokyo

# ----------------------------------------------------------------------------
# Xiaozhi bootstrap (ota.controller.ts / xiaozhi-ws.service.ts)
# ----------------------------------------------------------------------------
# Shared token handed to the device by POST /xiaozhi/ota (advisory; not enforced).
XIAOZHI_TOKEN=stackchan
# Host:port the OTA response tells the device to open the WS at. Leave UNSET to
# echo back the Host header the device used; set it to force a specific LAN IP,
# e.g. PUBLIC_WS_HOST=10.0.0.200:12800
# PUBLIC_WS_HOST=10.0.0.200:12800

# ----------------------------------------------------------------------------
# Server-push device events (events.controller.ts / xiaozhi-ws.service.ts)
# External producers (desktop notifiers, email hooks, Claude Code hooks, ...)
# POST /xiaozhi/events/{say,emotion,sound} to make an idle StackChan speak,
# change expression, or play a sound. Example:
#   curl -X POST http://localhost:12800/xiaozhi/events/say \
#     -H "Authorization: Bearer $XIAOZHI_EVENTS_TOKEN" \
#     -H 'Content-Type: application/json' \
#     -d '{"text": "New email from Bob.", "emotion": "happy"}'
# ----------------------------------------------------------------------------
# Bearer token producers must present. REQUIRED to enable the events API
# (unset/empty = all event requests get 503). Unlike the device tokens, this
# one is enforced — the API speaks arbitrary text on the robot.
# XIAOZHI_EVENTS_TOKEN=
# JSON keepalive period (ms) for idle device sockets. Keeps the firmware's
# 120s channel timer fresh so an idle device stays reachable and awake for
# pushed events. Must stay well under 120000; 0 disables (restores the stock
# firmware idle/light-sleep behavior, but pushes to a long-idle device may
# stall). While connected the device won't light-sleep or battery power-off,
# so notification targets should run docked.
# XIAOZHI_KEEPALIVE_MS=30000
# Directory of named notification sounds (WAV, any rate/channels), relative
# to private-server/. POST /xiaozhi/events/sound {"name":"chime"} plays
# sounds/chime.wav.
# XIAOZHI_SOUNDS_DIR=sounds
# Quiet gap (ms) the conversation must have had before a queued event plays,
# so notifications don't start over the user's first words or slam in the
# instant a reply ends.
# EVENT_QUIET_GRACE_MS=2000

# ----------------------------------------------------------------------------
# End-of-utterance detection (conversation.ts)
# ----------------------------------------------------------------------------
# With AEC on, the firmware listens in realtime mode and NEVER sends `listen
# stop` — the server VAD is the only thing that ends an utterance. Speech is
# detected against an adaptive threshold (a running ambient-noise estimate
# times a factor), so it self-calibrates to room and voice. Watch the
# "...listening (floor=..., attack=...)" server log lines to tune.
# Attack threshold never drops below this RMS (0..32767), however quiet the room.
# VAD_RMS_FLOOR=250
# Speech starts at noise-floor*SPEECH_FACTOR, continues down to noise-floor*RELEASE_FACTOR.
# VAD_SPEECH_FACTOR=3.0
# VAD_RELEASE_FACTOR=2.0
# Trailing silence (ms) after speech that ends the utterance.
# VAD_HANGOVER_MS=800
# Hard cap (ms) on a single utterance before forcing a turn.
# MAX_UTTERANCE_MS=15000
# Legacy escape hatch: set to pin a FIXED RMS threshold and disable adaptation.
# VAD_RMS_THRESHOLD=
