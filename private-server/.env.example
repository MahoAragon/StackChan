# StackChan private-server — environment variables
#
# Every value below is OPTIONAL: the server falls back to the localhost defaults
# shown here (see src/xiaozhi/config.ts and src/main.ts). Copy to `.env` and edit
# as needed. main.ts auto-loads this file via dotenv, so `npm run start:prod`
# (and `npm run start`) picks it up automatically — no need to source/export.

# ----------------------------------------------------------------------------
# Server bind (main.ts)
# ----------------------------------------------------------------------------
# TCP port. Matches the production StackChan server; the firmware expects 12800.
PORT=12800
# Bind address. 0.0.0.0 lets the device reach it over the LAN.
HOST=0.0.0.0

# ----------------------------------------------------------------------------
# LLM — OpenAI-compatible /v1/chat/completions server (e.g. llama.cpp)
# ----------------------------------------------------------------------------
# Base URL INCLUDING the /v1 suffix (passed as-is to the OpenAI SDK / ChatOpenAI).
LLM_BASE_URL=http://127.0.0.1:10000/v1
# Dummy key — local servers don't check auth. Set a real key only for cloud.
LLM_API_KEY=sk-local-dummy
# Model name the server expects (llama.cpp usually ignores it).
LLM_MODEL=default
# System prompt that sets StackChan's persona.
LLM_SYSTEM_PROMPT=You are StackChan, a friendly desktop robot companion. Keep replies short, warm, and conversational. Your replies are read aloud by text-to-speech: never use emojis, emoticons, or other symbols that do not read well aloud.

# ----------------------------------------------------------------------------
# STT — OpenAI-compatible /v1/audio/transcriptions server (whisper)
# ----------------------------------------------------------------------------
# Backend: "whispercpp" for a native whisper.cpp whisper-server (Apple Silicon
# Metal — uses STT_WHISPERCPP_URL, not STT_BASE_URL), or "openai" for any
# OpenAI-compatible /v1/audio/transcriptions server (e.g. the Dockerized
# faster-whisper fallback, which listens on STT_BASE_URL below).
STT_BACKEND=whispercpp
# whisper.cpp /inference endpoint — only used when STT_BACKEND=whispercpp.
STT_WHISPERCPP_URL=http://127.0.0.1:10010/inference
STT_BASE_URL=http://127.0.0.1:8000/v1
STT_API_KEY=sk-local-dummy
# A model id your whisper server recognizes (NOT the OpenAI alias "whisper-1").
# Must match WHISPER__MODEL in docker-compose.yml. Ignored when
# STT_BACKEND=whispercpp (whisper.cpp picks the model at server start).
STT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# Spoken language hint. Leave EMPTY to let the server auto-detect.
STT_LANGUAGE=en

# ----------------------------------------------------------------------------
# TTS — OpenAI-compatible /v1/audio/speech server (Kokoro-FastAPI / openedai / Piper)
# Must be able to return response_format "pcm" (s16le mono 24 kHz).
# ----------------------------------------------------------------------------
TTS_BASE_URL=http://127.0.0.1:50060/v1
TTS_API_KEY=sk-local-dummy
# Kokoro-FastAPI expects "kokoro" (not the OpenAI alias "tts-1").
TTS_MODEL=kokoro
# Voice id understood by your TTS server (e.g. Kokoro "af_sky").
TTS_VOICE=af_sky

# ----------------------------------------------------------------------------
# Xiaozhi bootstrap (ota.controller.ts / xiaozhi-ws.service.ts)
# ----------------------------------------------------------------------------
# Shared token handed to the device by POST /xiaozhi/ota (advisory; not enforced).
XIAOZHI_TOKEN=stackchan
# Host:port the OTA response tells the device to open the WS at. Leave UNSET to
# echo back the Host header the device used; set it to force a specific LAN IP,
# e.g. PUBLIC_WS_HOST=10.0.0.200:12800
# PUBLIC_WS_HOST=10.0.0.200:12800

# ----------------------------------------------------------------------------
# End-of-utterance detection (conversation.ts)
# ----------------------------------------------------------------------------
# The device (auto mode) usually sends its own `listen stop`, but the server
# also ends a turn on VAD silence or a length cap so it responds even if the
# stop never arrives. Tune against your mic if turns end too early/late.
# RMS (0..32767) above which a 60ms frame counts as speech.
# VAD_RMS_THRESHOLD=600
# Trailing silence (ms) after speech that ends the utterance.
# VAD_HANGOVER_MS=800
# Hard cap (ms) on a single utterance before forcing a turn.
# MAX_UTTERANCE_MS=15000
