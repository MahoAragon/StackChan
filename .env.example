# Copy this file to `.env` (git-ignored) and set your values.
# `just build` / `just flash` bake these into the firmware at build time by
# generating firmware/sdkconfig.defaults.local (also git-ignored).

# Base URL of the StackChan private-server, as reachable from the device over
# Wi-Fi — use this machine's LAN IP, not 127.0.0.1/localhost.
#   macOS: ipconfig getifaddr en0
PRIVATE_SERVER_URL=http://192.168.1.100:12800
